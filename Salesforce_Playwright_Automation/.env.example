# Copy to `.env` and fill in your Salesforce credentials.
SF_BASE_URL=https://<your-org>.lightning.force.com/one/one.app
SF_USERNAME=<salesforce-username>
SF_PASSWORD=<salesforce-password>
HEADLESS=true
# Optional: SMS/email verification code for the identity-verification step.
# Leave blank to enter it manually in a headed browser.
SF_VERIFICATION_CODE=
# How long to wait for manual MFA entry when no code is supplied (ms).
SF_MFA_TIMEOUT_MS=300000
